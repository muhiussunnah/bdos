# ─────────────────────────────────────────────────────────────
# Supabase — create a project at https://supabase.com and paste
# the values from Project Settings → API.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used by API routes for privileged writes (never exposed
# to the browser). Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─────────────────────────────────────────────────────────────
# Admin — the email that unlocks the /admin console.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_ADMIN_EMAIL=you@example.com

# ─────────────────────────────────────────────────────────────
# Platform fallback keys (optional). Each user can also enter their
# own keys in Settings → these are only used if the user has none.
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=

# Resend — outbound email. https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM="BDOS <onboarding@resend.dev>"

# App base URL (used for auth redirects & webhooks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
